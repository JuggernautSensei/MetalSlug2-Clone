{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": { "VCPKG_ROOT": "C:/vcpkg" },
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "test",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "vs",
      "inherits": "base",
      "displayName": "Visual Studio 2026 (x64)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    }
  ],
  "buildPresets": [
    { "name": "vs-debug", "configurePreset": "vs", "configuration": "Debug" },
    { "name": "vs-release", "configurePreset": "vs", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "vs-debug", "configurePreset": "vs", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
