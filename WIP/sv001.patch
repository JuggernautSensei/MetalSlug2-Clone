+        { "Slug_Enter", 7, 12 },
+        { "Slug_HitFront", 16, 30 },
+        { "Slug_HitBack", 10, 30 },
+        { "Slug_AirHitA", 14, 30 },
+        { "Slug_AirHitB", 12, 30 },
+        { "Slug_Vulcan_Idle", 32, 1 },
