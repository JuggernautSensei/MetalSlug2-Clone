+
+int SlugVehicle::GetDamageStage() const
+{
+    if (m_hp <= 0)
+    {
+        return 0;
+    }
+    const float ratio = GetHpRatio();
+    if (ratio <= m_tuning.damage.fireRatio)
+    {
+        return 2;
+    }
+    return ratio <= m_tuning.damage.smokeRatio ? 1 : 0;
+}
