+void SlugVehicle::PushFeetXMax(
+    const float _maxX)
+{
+    if (m_body.position.x > _maxX)
+    {
+        m_body.position.x = _maxX;
+        if (m_body.velocity.x > 0.f)
+        {
+            m_body.velocity.x = 0.f;
+        }
+    }
+}
