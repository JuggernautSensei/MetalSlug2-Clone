+
+namespace
+{
+    constexpr ARRAY<SlugClipInfo, static_cast<size_t>(eSlugClip::Count)> kClipTable = { {
+        { "Slug_Idle", 3, 6 },
+        { "Slug_Drive", 20, 20 },
+        { "Slug_AccelFwd", 4, 15 },
+        { "Slug_AccelBack", 4, 15 },
+        { "Slug_Elev", 10, 15 },
+        { "Slug_Jump", 4, 12 },
