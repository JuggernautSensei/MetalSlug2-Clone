+bool SlugVehicle::IsBlinkWhite() const
+{
+    if (m_mode == eSlugMode::Exploding)
+    {
+        return !m_bExploded && ((m_modeTicks / 3) % 2) == 0;
+    }
+    if (m_selfDestructTicks >= 0)
+    {
+        return ((m_selfDestructTicks / 6) % 2) == 0;
+    }
+    return false;
