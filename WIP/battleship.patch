+        ys, xs = np.where(sub > 0)
+        fr.append([lefts[i] + int(xs.min()), 1750 + int(ys.min()), int(xs.max() - xs.min() + 1), int(ys.max() - ys.min() + 1)])
+    clips.append({"name": "Boss_Cannon_Deploy", "frames": fr, "pivot": "foot", "fps": 12, "loop": False})
