      "params": { "ai": "missile", "detect": 400, "fireFrame": 10 },
      "clips": { "throw": { "name": "SD_Throw_Missle_{side}", "frames": 18, "sec": 0.08 } },
      "weapons": { "attack": { "projectile": "soldier_missile_proj", "muzzle": [0, -62], "aim": "facing", "tilt": { "threshold": 25, "dy": 0.1 } } }
    },

