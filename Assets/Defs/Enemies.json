{
  "version": 1,
  "note": "적 정의 (Docs/EnemyDefsSchema.md, 수치 근거 Docs/EnemySpecs.md). 클립 name 의 {side} 는 Left/Right. 시간 sec 는 프레임 길이(초).",
  "globals": { "dpsRef": 10, "activationMarginPx": 150, "despawnBehindCameraPx": 200, "despawnBelowCameraPx": 300 },
  "defs": {

    "human_base": {
      "abstract": true,
      "note": "병사류 공통: 몸통 40x75, 사망 연출(SD_Die_*). 하위 정의가 clips/params 를 더한다.",
      "kind": "walker",
      "human": true,
      "hp": 1,
      "score": 100,
      "body": { "w": 40, "h": 75, "cx": 0, "cy": -37.5 },
      "activation": { "marginPx": 150, "latch": true },
      "clips": {
        "dieBomb":   { "name": "SD_Die_Bomb_{side}",    "frames": 8,  "sec": 0.08, "loop": true },
        "dieSlash":  { "name": "SD_Die_Slash_{side}",   "frames": 12, "sec": 0.08 },
        "dieStand1": { "name": "SD_Die_Stand_1_{side}", "frames": 11, "sec": 0.08 },
        "dieStand2": { "name": "SD_Die_Stand_2_{side}", "frames": 10, "sec": 0.1 },
        "dieFall":   { "name": "SD_Die_Fall_{side}",    "frames": 4,  "sec": 0.1 },
        "dieLand":   { "name": "SD_Die_Land_{side}",    "frames": 7,  "sec": 0.1 },
        "dieJump":   { "name": "SD_Die_Jump_{side}",    "frames": 10, "sec": 0.08 }
      },
      "death": {
        "bomb": "dieBomb", "slash": "dieSlash", "stand1": "dieStand1", "stand2": "dieStand2",
        "fall": "dieFall", "land": "dieLand", "jump": "dieJump",
        "fallAt1": 10, "fallAt2": 8,
        "blinkAtSec": 2.0, "blinkForSec": 1.0, "blinkPeriodSec": 0.1, "removeAtSec": 3.0,
        "bloodOffsetY": -27.5, "bombVelocity": [110, -430]
      }
    },

    "soldier_base": {
      "abstract": true,
      "extends": "human_base",
      "note": "보병(Soldier) 공통 몸/클립. AI 는 하위 정의(bomb/sword/missile)가 정한다.",
      "behavior": "soldier",
      "physics": { "gravity": 1000, "maxFall": 3000, "speed": 100, "jumpVy": -450, "dropSpeed": 100, "footHalfWidth": 4, "useGravity": true },
      "clips": {
        "idle":     { "name": "SD_Idle_{side}",      "frames": 6,  "sec": 0.1, "loop": true },
        "move":     { "name": "SD_Move_{side}",      "frames": 12, "sec": 0.08, "loop": true },
        "moveDown": { "name": "SD_MoveDown_{side}",  "frames": 9,  "sec": 0.07 },
        "fall":     { "name": "SD_Jump_{side}",      "frames": 5,  "sec": 0.1 },
        "hJump":    { "name": "SD_MoveJump_{side}",  "frames": 6,  "sec": 0.08 },
        "land":     { "name": "SD_Land_{side}",      "frames": 3,  "sec": 0.08 }
      },
      "params": {
        "cooldown": 1.0,
        "dropDy": 50,
        "jumpDy": 100,
        "wallProbe": { "w": 40, "h": 50, "cx": 25, "cy": -37.5 }
      }
    },

    "soldier_bomb": {
      "extends": "soldier_base",
      "note": "SWORD/BOMB_THROWER: 폭탄 투척 (EnemySpecs 1.1)",
      "params": { "ai": "bomb", "detect": 350, "closeStop": 200, "fireFrame": 10 },
      "clips": { "throw": { "name": "SD_Throw_Bomb_{side}", "frames": 14, "sec": 0.08 } },
      "weapons": { "attack": { "projectile": "soldier_bomb_proj", "muzzle": [0, -37], "aim": "facing" } }
    },

    "soldier_sword": {
      "extends": "soldier_base",
      "note": "SWORD_MAN: 칼 베기 + 점프 베기 (EnemySpecs 1.1)",
      "params": { "ai": "sword", "detect": 350, "jumpAttack": 150, "swordNear": 100, "slashFrame": 9, "jumpSlashFrame": 2, "jumpReadySec": 0.5 },
      "clips": {
        "slash":         { "name": "SD_Slash_{side}",           "frames": 23, "sec": 0.08 },
        "jumpSlashReady":{ "name": "SD_Jump_Slash_Ready_{side}", "frames": 2,  "sec": 0.12 },
        "jumpSlash":     { "name": "SD_Jump_Slash_{side}",      "frames": 5,  "sec": 0.08 },
        "jumpSlashLand": { "name": "SD_Jump_Slash_Land_{side}", "frames": 14, "sec": 0.08 }
      },
      "weapons": {
        "slash":     { "hitbox": { "w": 60, "h": 50, "cx": 35, "cy": -37, "lifeSec": 0.4,  "damage": 1, "follow": false } },
        "jumpSlash": { "hitbox": { "w": 70, "h": 70, "cx": 35, "cy": -37, "lifeSec": 0.25, "damage": 1, "follow": true } }
      }
    },

    "soldier_missile": {
      "extends": "soldier_base",
