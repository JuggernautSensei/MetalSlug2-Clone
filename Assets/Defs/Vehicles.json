    "sarubia_grenade": {
      "kind": "projectile",
      "note": "사루비아 수류탄 (EnemySpecs 2.5): 수직 낙하(중력 300, 상한 300) → 착지 후 지면을 100 px/s 로 구름 → 착지 후 5 s 에 시각 전용 폭발로 소멸. 플레이어 접촉은 치명.",
      "box": { "w": 25, "h": 25 },
      "gravity": 300,
      "maxFall": 300,
      "lifetime": 10,
      "rollSpeed": 100,
      "rollSec": 5,
      "expireFx": true,
      "groundProbe": 14,
      "anim": {
        "begin": { "name": "Sarubia_Proj_Start",     "frames": 8,  "sec": 0.08 },
        "land":  { "name": "Sarubia_Proj_Collision", "frames": 6,  "sec": 0.08 },
        "fly":   { "name": "Sarubia_Proj_{side}",    "frames": 21, "sec": 0.08, "loop": true }
      },
      "onSolid": "explode",
      "explosion": { "fx": "PlayerBombExplosion", "offset": [0, 0] }
    },

