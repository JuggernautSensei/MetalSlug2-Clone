    "vehicle_btank_shell": {
      "kind": "projectile",
      "note": "전차 포탄 (EnemySpecs 2.3): v0 (-400 vx, -200 vy), 중력 500, 낙하 상한 500.",
      "box": { "w": 20, "h": 20 },
      "v0": [400, -200],
      "gravity": 500,
      "maxFall": 500,
      "anim": { "fly": { "name": "BTank_Proj", "frames": 3, "sec": 0.05, "loop": true } },
      "onSolid": "explode",
      "explosion": { "fx": "Explosion_Mid", "offset": [0, -35] }
    },

    "btank": {
      "kind": "vehicle",
      "behavior": "btank",
      "note": "전차 (EnemySpecs 2.3). 플레이어가 x-500 을 넘으면 문을 열고 3 s 마다 2연발. 좌향 고정 (원작 MS2). 활성은 행동이 직접 켠다 (margin 을 음수로 두어 화면 활성을 끈다).",
      "ttk": 12,
      "hp": 120,
      "score": 1000,
      "body": { "w": 100, "h": 100, "cx": 0, "cy": -50 },
      "hurtbox": { "w": 190, "h": 90, "cx": 0, "cy": -45 },
      "activation": { "marginPx": -100000, "latch": true },
      "physics": { "gravity": 1000, "maxFall": 3000, "useGravity": true },
      "clips": {
        "idle":    { "name": "BTank_Idle",        "frames": 1,  "sec": 0.08 },
        "open":    { "name": "BTank_Animing_Up",  "frames": 8,  "sec": 0.12 },
        "fire":    { "name": "BTank_Fire",        "frames": 11, "sec": 0.08 },
        "destroy": { "name": "BTank_Destory",     "frames": 8,  "sec": 0.12 }
      },
      "weapons": {
        "shell": { "projectile": "vehicle_btank_shell", "muzzle": [74.5, -95], "aim": "facing", "muzzleFx": { "clip": "BTank_Shot_Effect", "offset": [-70.5, 17.5] } }
      },
      "death": {
        "removeAtSec": 4.0,
        "fx": [
          { "clip": "Explosion_Huge", "offset": [0, -40], "depth": 60 },
          { "clip": "Metal2", "offset": [-40, -30], "debris": true },
          { "clip": "Metal5", "offset": [-10, -60], "debris": true },
          { "clip": "Metal8", "offset": [20, -45], "debris": true },
          { "clip": "Metal10", "offset": [45, -25], "debris": true },
          { "clip": "Metal12", "offset": [-25, -70], "debris": true }
        ]
      },
      "params": {
        "activateDx": 500,
        "idleSec": 3.0,
        "shotsPerCycle": 2,
        "fireFrame": 2
      }
    },

    "missle_proj_down": {
      "kind": "projectile",
      "note": "미사일 전차 직사 (EnemySpecs 2.4): 수평 300, 중력 400, 낙하 중 폭발 없이 지면/플레이어에서 소멸.",
      "box": { "w": 25, "h": 25 },
      "v0": [300, 0],
      "gravity": 400,
      "anim": { "fly": { "name": "MissleTank_Proj_1", "frames": 7, "sec": 0.1 } },
