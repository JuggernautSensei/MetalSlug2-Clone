{
  "version": 1,
  "note": "차량 / 전차 정의 (Docs/EnemySpecs.md §2). 원점 = 발. 연출 offset 은 발 기준 (레거시 중심 기준 offset 에 -(0,F) 를 더한 값). 클립 name 의 {side} 는 Left/Right. HP = TTK x 10 (dpsRef).",
  "defs": {

    "jeep_proj": {
      "kind": "projectile",
      "note": "지프 로켓 (EnemySpecs 2.1): 점화 0.4 s 정지 → 직선 300 px/s. 기울임은 무기 tilt.",
      "box": { "w": 50, "h": 20 },
      "speed": 300,
      "startDelay": 0.4,
      "anim": {
        "begin": { "name": "Jeep_Proj_Begin_{side}", "frames": 5, "sec": 0.08 },
        "fly":   { "name": "Jeep_Proj_{side}",       "frames": 3, "sec": 0.08, "loop": true }
      },
      "onSolid": "explode",
      "explosion": { "fx": "Explosion_Mid", "offset": [0, -35] }
    },

    "jeep": {
      "kind": "vehicle",
      "behavior": "jeep",
      "note": "이동 로켓 지프 (EnemySpecs 2.1). 화면 가장자리 사이를 오가며 플레이어가 발사 쪽(뒤)에 있을 때 로켓 4발.",
      "ttk": 8,
      "hp": 80,
      "score": 500,
      "body": { "w": 75, "h": 60, "cx": 0, "cy": -30 },
      "hurtbox": { "w": 120, "h": 114, "cx": 0, "cy": -57 },
      "activation": { "marginPx": 150, "latch": true },
      "physics": { "gravity": 1000, "maxFall": 3000, "speed": 200, "jumpVy": 0, "dropSpeed": 0, "footHalfWidth": 4, "useGravity": true },
      "clips": {
        "idle":      { "name": "Jeep_Idle_{side}",       "frames": 2,  "sec": 0.08, "loop": true },
        "move":      { "name": "Jeep_Move_{side}",       "frames": 8,  "sec": 0.08, "loop": true },
        "turn":      { "name": "Jeep_Turn_{side}",       "frames": 12, "sec": 0.08 },
        "aimming":   { "name": "Jeep_Aimming_{side}",    "frames": 12, "sec": 0.08 },
        "ready":     { "name": "Jeep_Ready_{side}",      "frames": 2,  "sec": 0.08, "loop": true },
        "shotReady": { "name": "Jeep_Shot_Ready_{side}", "frames": 12, "sec": 0.08 },
        "shot":      { "name": "Jeep_Shot_{side}",       "frames": 8,  "sec": 0.08 },
        "reAim":     { "name": "Jeep_ReAimming_{side}",  "frames": 12, "sec": 0.08 },
        "destroy":   { "name": "Jeep_Destroy_{side}",    "frames": 17, "sec": 0.08 }
      },
      "weapons": {
        "rocket": { "projectile": "jeep_proj", "muzzle": [-51, -88], "aim": "given", "tilt": { "threshold": 50, "dy": 0.1 } }
      },
      "death": {
        "removeAtSec": 1.7,
        "fx": [
          { "clip": "Explosion_Huge", "offset": [0, -50], "depth": 60 },
          { "clip": "Explosion_Huge", "offset": [0, -50], "delay": 1.7 },
          { "clip": "Metal1", "offset": [-30, -40], "delay": 1.7, "debris": true },
          { "clip": "Metal4", "offset": [10, -35], "delay": 1.7, "debris": true },
          { "clip": "Metal7", "offset": [-10, -55], "delay": 1.7, "debris": true },
          { "clip": "Metal9", "offset": [25, -30], "delay": 1.7, "debris": true },
          { "clip": "Metal11", "offset": [-40, -20], "delay": 1.7, "debris": true }
        ]
      },
      "params": {
        "speed": 200,
        "targetTol": 10,
        "edgeInset": 55,
        "idleSec": 1.0,
        "waitSec": 2.0,
        "firstWaitSec": 1.5,
        "bullets": 4,
        "fireFrame": 1,
        "rocketShiftX": 20
      }
