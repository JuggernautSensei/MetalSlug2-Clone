        "idle":      { "name": "Sarubia_Idle_{side}",       "frames": 2,  "sec": 0.08, "loop": true },
        "turn":      { "name": "Sarubia_Turn_{side}",       "frames": 11, "sec": 0.08 },
        "moveStart": { "name": "Sarubia_Move_Start_{side}", "frames": 6,  "sec": 0.08 },
        "move":      { "name": "Sarubia_Move_{side}",       "frames": 6,  "sec": 0.08, "loop": true },
