      "activation": { "mode": "always" },
      "physics": { "gravity": 1000, "maxFall": 3000, "useGravity": true },
      "clips": {
        "idleUp":      { "name": "MissleTank_Up_Idle_{side}",        "frames": 2,  "sec": 0.08, "loop": true },
        "idleDown":    { "name": "MissleTank_Down_Idle_{side}",      "frames": 2,  "sec": 0.08, "loop": true },
        "aimUp":       { "name": "MissleTank_AimmingUp_{side}",      "frames": 9,  "sec": 0.08 },
        "aimDown":     { "name": "MissleTank_AimmingDown_{side}",    "frames": 9,  "sec": 0.08 },
        "readyUp":     { "name": "MissleTank_Up_Ready_Shot_{side}",  "frames": 3,  "sec": 0.08, "loop": true },
        "readyDown":   { "name": "MissleTank_Down_Ready_Shot_{side}", "frames": 3,  "sec": 0.08, "loop": true },
        "shotUp":      { "name": "MissleTank_Up_Shot_{side}",        "frames": 7,  "sec": 0.08 },
        "shotDown":    { "name": "MissleTank_Down_Shot_{side}",      "frames": 7,  "sec": 0.08 },
        "destroyUp":   { "name": "MissleTank_Up_Destroy_{side}",     "frames": 20, "sec": 0.08 },
        "destroyDown": { "name": "MissleTank_Down_Destroy_{side}",   "frames": 21, "sec": 0.08 }
      },
      "weapons": {
        "up":   { "projectile": "missle_proj_up",   "muzzle": [50, -180], "aim": "facing", "muzzleFx": { "clip": "MissleTank_Up_Proj_Effect_{side}",   "offset": [-46, 120] } },
        "down": { "projectile": "missle_proj_down", "muzzle": [87, -90],  "aim": "facing", "muzzleFx": { "clip": "MissleTank_Down_Proj_Effect_{side}", "offset": [-232.5, 0] } }
      },
      "death": {
        "removeAtSec": 2.0,
