    "missle_proj_up": {
      "kind": "projectile",
      "note": "미사일 전차 곡사 (EnemySpecs 2.4): v0 (300, -200), 중력 400.",
      "box": { "w": 25, "h": 25 },
      "v0": [300, -200],
      "gravity": 400,
      "anim": { "fly": { "name": "MissleTank_Proj_0", "frames": 12, "sec": 0.1 } },
      "onSolid": "explode",
      "explosion": { "fx": "Explosion_Mid", "offset": [0, 0] }
    },

    "missle_tank": {
      "kind": "vehicle",
