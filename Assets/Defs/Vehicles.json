      "ttk": 15,
      "hp": 150,
      "score": 2000,
      "body": { "w": 100, "h": 100, "cx": 0, "cy": -50 },
      "hurtbox": { "w": 144, "h": 192, "cx": 0, "cy": -96 },
      "activation": { "marginPx": 150, "latch": true },
      "physics": { "gravity": 1000, "maxFall": 3000, "speed": 100, "jumpVy": -450, "dropSpeed": 100, "footHalfWidth": 4, "useGravity": true },
