          { "clip": "Metal5", "offset": [15, -60], "delay": 2.0, "debris": true },
          { "clip": "Metal6", "offset": [35, -90], "delay": 2.0, "debris": true },
          { "clip": "Metal9", "offset": [-30, -20], "delay": 2.0, "debris": true },
