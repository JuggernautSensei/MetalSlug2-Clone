          { "clip": "Explosion_Huge", "offset": [0, -30], "delay": 2.0, "depth": 60 },
          { "clip": "Fx_FireBomb_Air", "offset": [0, -40], "delay": 2.0, "depth": 60 },
          { "clip": "Metal1", "offset": [-35, -40], "delay": 2.0, "debris": true },
          { "clip": "Metal3", "offset": [-10, -60], "delay": 2.0, "debris": true },
          { "clip": "Metal5", "offset": [20, -35], "delay": 2.0, "debris": true },
          { "clip": "Metal6", "offset": [40, -55], "delay": 2.0, "debris": true },
          { "clip": "Metal8", "offset": [-45, -20], "delay": 2.0, "debris": true },
          { "clip": "Metal10", "offset": [5, -75], "delay": 2.0, "debris": true }
        ]
      },
