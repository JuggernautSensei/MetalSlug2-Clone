      "weapons": {
        "grenade": { "projectile": "sarubia_grenade", "muzzle": [64, -150], "aim": "facing", "muzzleFx": { "clip": "Sarubia_Proj_Effect_{side}", "offset": [-46, 104.5] } }
      },
      "death": {
        "removeAtSec": 2.0,
        "fx": [
          { "clip": "Explosion_Small", "offset": [-25, -90], "depth": 60 },
          { "clip": "Explosion_Mid",   "offset": [20, -105], "depth": 60 },
          { "clip": "Explosion_Large", "offset": [0, -100], "depth": 60 },
